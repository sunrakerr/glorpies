{
  "name": "glorpies",
  "version": "0.1.0",
  "description": "Ugly little alien avatars from any string: 9 quadrillion of them, hand-painted in watercolour and ink, alive. The same name always gets the same face. React, Vue, Svelte, Solid, Preact, a web component, server images and a CLI, with zero dependencies.",
  "license": "MIT",
  "author": "Aditya Shenoy (https://github.com/sunrakerr)",
  "homepage": "https://glorpies.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunrakerr/glorpies.git",
    "directory": "packages/glorpies"
  },
  "bugs": {
    "url": "https://github.com/sunrakerr/glorpies/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "avatar",
    "avatars",
    "alien",
    "generative",
    "deterministic",
    "identicon",
    "face",
    "watercolour",
    "web-component",
    "react",
    "bot",
    "agent",
    "og-image",
    "vue",
    "svelte",
    "solid",
    "preact",
    "angular",
    "astro"
  ],
  "sideEffects": [
    "./src/element.ts",
    "./dist/element.js"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./element": "./src/element.ts",
    "./react": "./src/react.tsx",
    "./vue": "./src/vue.ts",
    "./preact": "./src/preact.ts",
    "./solid": "./src/solid.ts",
    "./server": "./src/server.ts",
    "./internal/*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./element": {
        "types": "./dist/element.d.ts",
        "import": "./dist/element.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "import": "./dist/react.js"
      },
      "./vue": {
        "types": "./dist/vue.d.ts",
        "import": "./dist/vue.js"
      },
      "./preact": {
        "types": "./dist/preact.d.ts",
        "import": "./dist/preact.js"
      },
      "./solid": {
        "types": "./dist/solid.d.ts",
        "import": "./dist/solid.js"
      },
      "./svelte": {
        "types": "./dist/svelte/index.d.ts",
        "svelte": "./dist/svelte/index.js",
        "import": "./dist/svelte/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.js"
      },
      "./package.json": "./package.json"
    },
    "bin": {
      "glorpies": "./dist/cli.js"
    }
  },
  "unpkg": "./dist/cdn/glorpies.js",
  "jsdelivr": "./dist/cdn/glorpies.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-svelte.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "pnpm build && pnpm test",
    "lint:package": "rm -rf .pack && pnpm pack --pack-destination .pack && publint .pack/glorpies-*.tgz && attw .pack/glorpies-*.tgz --profile esm-only",
    "test:browser": "node test/browser.mjs"
  },
  "peerDependencies": {
    "@napi-rs/canvas": ">=0.1.60",
    "preact": ">=10",
    "react": ">=18",
    "solid-js": ">=1.8",
    "svelte": ">=4",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@napi-rs/canvas": "^1.0.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "gifenc": "^1.0.3",
    "preact": "^11.1.0",
    "preact-render-to-string": "^6.8.2",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "solid-js": "^1.9.17",
    "svelte": "^5.57.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vue": "^3.5.44"
  }
}
